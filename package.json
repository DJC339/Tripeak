{
  "name": "tripeak-digital-site",
  "version": "0.1.0",
  "private": true,
  "description": "Tripeak Digital marketing site (Eleventy + Tailwind CSS).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "eleventy --serve",
    "clean": "node -e \"fs.rmSync('_site',{recursive:true,force:true})\"",
    "build": "npm run clean && eleventy",
    "test:build": "node --test \"tests/build/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test": "npm run test:build && npm run test:e2e",
    "test:install": "playwright install chromium"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@11ty/eleventy-img": "7.0.0",
    "@axe-core/playwright": "4.14.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3"
  }
}
